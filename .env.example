LLM_PROVIDER=gemini
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=

# Data source selection. Keep mock for local review until Supabase is configured.
DATA_SOURCE=mock

# Supabase client/auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres / Prisma.
# DATABASE_URL should use the pooled transaction connection string.
# DIRECT_URL should use the direct/session connection string for migrations.
DATABASE_URL=
DIRECT_URL=
